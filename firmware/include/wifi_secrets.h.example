#pragma once

// Szablon nadpisania domyślnych danych WiFi AP / OTA. Skopiuj ten plik jako
// "wifi_secrets.h" (bez .example) w tym samym katalogu, jeśli chcesz inne
// SSID/hasło niż domyślne w config.h — wifi_secrets.h jest w .gitignore,
// więc nie trafi do (publicznego) repo Git.
//
// Jeśli ten plik NIE istnieje, firmware i tak działa — używa domyślnych
// wartości z config.h (SSID "G100-Programator-OTA", hasło "g100programator").
// ESP32 zawsze tworzy WŁASNY WiFi AP (nie dołącza do istniejącej sieci) —
// telefon/PC łączy się z tą siecią, żeby wgrać nowy firmware przez OTA.
// BLE i Modbus (RS-485) są od tego całkowicie niezależne.

#define OTA_AP_SSID     "G100-Programator-OTA"
#define OTA_AP_PASSWORD "TwojeSilniejszeHaslo" // min. 8 znakow (wymog WiFi AP)

// Nazwa widoczna w narzędziu OTA (pio run -e esp32dev_ota -t upload)
#define OTA_HOSTNAME    "g100-programator"

// Hasło do samego kanału OTA (osobne od hasła AP) — zalecane, bo inaczej
// każdy połączony z AP mógłby spróbować wgrać firmware na ESP32.
// Puste "" = brak hasła.
#define OTA_PASSWORD    ""
