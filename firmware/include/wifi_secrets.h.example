#pragma once

// Szablon danych WiFi/OTA. Skopiuj ten plik jako "wifi_secrets.h" (bez
// .example) w tym samym katalogu i wpisz prawdziwe dane — wifi_secrets.h
// jest w .gitignore, więc nie trafi do (publicznego) repo Git.
//
// Jeśli plik wifi_secrets.h nie istnieje, firmware kompiluje się i działa
// normalnie — po prostu bez WiFi/OTA (BLE i Modbus są od tego całkowicie
// niezależne, patrz main.cpp).

#define WIFI_SSID       "TwojaSiecWiFi"
#define WIFI_PASSWORD   "TwojeHaslo"

// Nazwa widoczna w narzędziu OTA (pio run -t upload --upload-port <hostname>.local)
#define OTA_HOSTNAME    "g100-programator"

// Hasło do samego kanału OTA (osobne od hasła WiFi) — zalecane, bo inaczej
// każdy w tej samej sieci WiFi mógłby spróbować wgrać firmware na ESP32.
// Puste "" = brak hasła (nie zalecane poza siecią zaufaną).
#define OTA_PASSWORD    ""
